# Copy this file to .env.devcontainer and fill in your secrets
# DO NOT commit .env.devcontainer to git (it's in .gitignore)

# From .env.development.local
WINDING_SITE_ACCESS_PASSWORD=YOUR_SHARED_PASSWORD

# From .env.local (Azure Content Understanding)
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=https://gator-content-understanding.services.ai.azure.com
AZURE_CONTENT_UNDERSTANDING_ANALYZER_ID=DesignPacketClassifier
AZURE_CONTENT_UNDERSTANDING_API_VERSION=2025-11-01
CONTENT_UNDERSTANDING_KEY=YOUR_KEY_HERE

# ngrok agent token. Keep this only in .env.devcontainer.
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# This account's assigned dev domain. The agent connection is temporary, but
# the authenticated dev-domain address remains reusable across rebuilds.
NGROK_URL=https://viewable-sympathy-recipient.ngrok-free.dev
